/**
 * SkyMaster App Layout · Root Layout (Next.js 14 App Router)
 * 用法：将本文件放到 frontend/src/app/layout.tsx
 * 依赖：antd 5.12+, tailwindcss 3+
 */

import { ConfigProvider } from 'antd';
import zhCN from 'antd/locale/zh_CN';
import { skymasterDarkTheme } from '@/theme/skymasterDarkTheme';
import '@/theme/globals.css';

export const metadata = {
  title:       'SkyMaster · 智能无人机管控平台',
  description: '军工级私有化多协议无人机管控平台',
};

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="zh-CN" className="dark">
      <body className="bg-base text-text-primary font-sans antialiased overflow-hidden">
        <ConfigProvider theme={skymasterDarkTheme} locale={zhCN} componentSize="middle">
          {children}
        </ConfigProvider>
      </body>
    </html>
  );
}

